<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_umh_connector" model="ir.ui.view">
        <field name="name">res.partner.form.umh.connector</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_umh_whatsapp" type="object"
                        class="oe_stat_button" icon="fa-whatsapp">
                    <div class="o_stat_info">
                        <span class="o_stat_text">WhatsApp</span>
                    </div>
                </button>
                <button name="action_open_umh_telegram" type="object"
                        class="oe_stat_button" icon="fa-telegram">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Telegram</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook[1]" position="before">
                <group string="UMH Messenger">
                    <field name="x_whatsapp_number" placeholder="z.B. +49123456789 (auch wenn identisch mit Telefon)"/>
                    <field name="x_telegram_chat_id" placeholder="z.B. 123456789 (Chat-ID aus UMH)"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
